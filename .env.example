# Surakhsa Core - copy to .env and fill in values
PORT=5001
NODE_ENV=development
JWT_SECRET=change-this-to-a-long-random-string
# Demo OTP shown on login page (no real SMS). Set false to hide code from API.
SHOW_DEMO_OTP=true

# Optional: Firebase, MongoDB, Twilio (not required for demo mode)
FIREBASE_PROJECT_ID=your_project_id
MONGODB_URI=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
